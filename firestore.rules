rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fallback: Deny access to unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped isolation:
    // Money lenders can ONLY read and write documents and subcollections
    // stored under their own authenticated UID.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Loans subcollection
      match /loans/{loanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // FCM device push tokens
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Any nested subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
